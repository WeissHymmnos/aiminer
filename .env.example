# Anthropic Claude API Key
ANTHROPIC_API_KEY="sk-ant-api03-..."
# OpenAI API Key
OPENAI_API_KEY="sk-proj-..."
# DeepSeek API Key
DEEPSEEK_API_KEY="sk-..."
# OpenRouter API Key
OPENROUTER_API_KEY="sk-or-v1-..."
# Groq API Key
GROQ_API_KEY="gsk_..."

# Kimi API Key (Moonshot)
KIMI_API_KEY="sk-..."
# Qwen API Key
QWEN_API_KEY="sk-..."
# Zhipu GLM API Key
ZHIPU_API_KEY="your-glm-api-key"

# Local LLM Support (Ollama / vLLM)
OLLAMA_BASE_URL="http://localhost:11434/v1"
VLLM_BASE_URL="http://localhost:8000/v1"

# Force use of local open-source embedding model (SentenceTransformers)
# Set to true to avoid API costs and 403 errors (e.g. Kimi embedding not open)
USE_LOCAL_EMBEDDING="true"

# Path to Qlib data directory (defaults to ~/.qlib/qlib_data/cn_data)
QLIB_DATA_PATH="~/.qlib/qlib_data/cn_data"
# RiceQuant credentials (required if using RiceQuant data provider)
RQ_TOKEN="your-license-token-here"
# OR use username/password
RQ_USER="your-username"
RQ_PASS="your-password"
# Add other optional environment variables below
