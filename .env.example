# =============================================================================
# AI Alpha Miner — environment template
# Copy to `.env` and fill in the keys you need. Never commit a real `.env`.
# =============================================================================

# --- LLM API keys (set at least one) ---
# Standard names (preferred):
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ZHIPU_API_KEY=
DEEPSEEK_API_KEY=
KIMI_API_KEY=
QWEN_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=

# Legacy aliases still supported:
# OpenAI_KEY=
# ClaudeCode_KEY=
# GLM_KEY=
# LLM_KEY=

# --- Optional: override OpenAI-compatible base URLs ---
# Useful for proxies, Azure OpenAI, or self-hosted gateways.
# OPENAI_BASE_URL=https://api.openai.com/v1
# CLAUDE_BASE_URL=https://api.anthropic.com/v1
# ANTHROPIC_BASE_URL=
# GLM_BASE_URL=
# LLM_BASE_URL=

# Local OpenAI-compatible servers
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_API_KEY=ollama
# VLLM_BASE_URL=http://localhost:8000/v1
# VLLM_API_KEY=vllm

# --- Embedding overrides (optional) ---
# EMBEDDING_BASE_URL=
# EMBEDDING_MODEL=
# USE_LOCAL_EMBEDDING=false

# --- RiceQuant (required for --mode ricequant) ---
# Token is preferred over username/password.
RQ_TOKEN=
RQ_USER=
RQ_PASS=

# --- Compute ---
# USE_GPU=true
