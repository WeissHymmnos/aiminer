# LLM API Keys
KIMI_API_KEY=your-kimi-api-key
MIMO_API_KEY=your-mimo-api-key
MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
QWEN_API_KEY=your-qwen-api-key
ZHIPU_API_KEY=your-zhipu-api-key
OpenAI_KEY=your-openai-api-key
ClaudeCode_KEY=your-claude-api-key

# RiceQuant Credentials
RQ_USER=your-phone-number
RQ_PASS=your-password
RQ_TOKEN=your-license-token

# RAG & Embedding Settings
# Set to 'true' to use local embedding instead of API
USE_LOCAL_EMBEDDING=false
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Compute Settings
# Use GPU for local embeddings or Polars if supported
# USE_GPU=true

# Runtime Paths
AIMINER_DATA_DIR=data
AIMINER_RESULTS_DIR=results
AIMINER_LOGS_DIR=logs
QLIB_CN_DATA_PATH=~/.qlib/qlib_data/cn_data
QLIB_US_DATA_PATH=~/.qlib/qlib_data/us_data
# Optional: local futures dataset root for data_backend=local
# AIMINER_LOCAL_DATA_PATH=data/local_futures

# Launch Guards
AIMINER_MAX_CONCURRENT_SWARMS=1
AIMINER_SWARM_RUN_TIMEOUT_SECONDS=3600
AIMINER_SWARM_RUN_HEARTBEAT_SECONDS=15
AIMINER_MANUAL_BACKTEST_TIMEOUT_SECONDS=600
AIMINER_STRATEGY_BACKTEST_TIMEOUT_SECONDS=900
